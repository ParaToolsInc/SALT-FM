# This script determines whether to call the SALT-FM C/C++ or Fortran instrumentor
# based on the file extension of the input source file or the --lang option.

set -o errexit
set -o nounset
set -o pipefail
#set -o verbose
#set -o xtrace

readonly _VERSION="@SALT_VERSION_FULL@"
# get the absolute path of this script, without `dirname`; a `\` also
# separates directories, as under MSYS
case ${BASH_SOURCE[0]} in
    */* | *\\*) _SCRIPT_DIR="${BASH_SOURCE[0]%[/\\]*}" ;;
    *) _SCRIPT_DIR=. ;;
esac
_SCRIPT_DIR="$(cd "${_SCRIPT_DIR:-/}" && pwd)"
readonly _SCRIPT_DIR

read -r -d '' _USAGE <<EOF || true
OVERVIEW: Tool for adding TAU instrumentation to source files.
Note that this will only instrument the first source file given.
USAGE: $0 [options] <source0> [... <sourceN>]

OPTIONS:

Generic SALT-FM Options:

  -h                            - Alias for --help
  --help                        - Display available options (--help-hidden for more)
  --help-fortran                - Display Fortran instrumentor options and usage information
  --help-c                      - Display C/C++ instrumentor options and usage information
  --help-cxx                    - Display C/C++ instrumentor options and usage information
  --version                     - Display the version of this program
  --lang=<string>               - Specify the language of the input source file (default: auto-detect)
  --show                        - Print the command line that would be executed by the outter wrapper script

TAU instrumentor options:

  --config_file=<filename>      - Specify path to SALT-FM configuration YAML file (default: \$SALT_CONFIG_FILE, else the installed config.yaml)
  --flang_exe=<path>            - Flang driver for Fortran (default: \$SALT_FLANG_EXE, else the one SALT-FM was built with)
  --tau_allow_parse_errors      - C and C++ only: instrument the partial parse tree that Clang builds after errors (default: \$SALT_ALLOW_PARSE_ERRORS, else false)
  --tau_build_uses_salt_flang   - Fortran only. The build compiles with the same LLVM
                                  Flang version that SALT-FM parses with (--flang_exe),
                                  or with a compiler that writes the same module files,
                                  for example amdflang of the same LLVM version.
                                  SALT-FM then reads and writes the .mod files in the
                                  build's module directories, and reads those of its
                                  libraries (for example MPI and HDF5). Without it,
                                  SALT-FM reads and writes only .saltmod files.
                                  (default: on if \$SALT_BUILD_USES_SALT_FLANG is set
                                  and is not empty or 0, else off)
  --tau_fabricate_unknown_types - Fabricate declarations for unknown qualified names (default: \$SALT_FABRICATE_UNKNOWN_TYPES, else false)
  --tau_instrument_inline       - Instrument inlined functions (default: false)
  --tau_excluded_main_setup=<none|routine|file>
                                - Selects which excluded main programs get setup code.
                                  Setup code makes sure that the measurement library
                                  starts correctly. We recommend it for all programs.
                                    none:    No excluded main program gets setup code.
                                    routine: A main program that the routine lists
                                             exclude gets setup code. This is the
                                             default.
                                    file:    A main program in a file that the file
                                             lists exclude also gets setup code. This
                                             makes SALT-FM parse all excluded files.
                                             SALT-FM adds setup code to each main
                                             program that it finds, but it adds no
                                             timers to these files.
                                  (default: \$SALT_EXCLUDED_MAIN_SETUP, else routine)
  --tau_parse_excluded_modules=<off|modules-only|submodules-and-modules>
                                - Fortran only. Selects which excluded files SALT-FM
                                  parses to write their module files. SALT-FM needs
                                  these module files to instrument the files that use
                                  the modules. It adds no timers to the excluded files.
                                    off:          SALT-FM parses no excluded file.
                                    modules-only: SALT-FM parses an excluded file that
                                                  defines a module, or has an INCLUDE
                                                  line or #include. This is the
                                                  default.
                                    submodules-and-modules:
                                                  SALT-FM also parses an excluded file
                                                  that has only submodules. Only the
                                                  child submodules of a submodule need
                                                  its module file.
                                  With --tau_excluded_main_setup=file, SALT-FM parses all
                                  files, and this option has no effect.
                                  (default: \$SALT_PARSE_EXCLUDED_MODULES, else modules-only)
  --tau_output=<filename>       - Specify name of output instrumented file
  --tau_select_file=<filename>  - Provide a selective instrumentation specification file
  --tau_use_cxx_api             - Use TAU's C++ instrumentation API
EOF

# Add a help/usage message function
function usage {
    echo "$_USAGE"
}

# Sets `option_value` to the canonical value of option `$1`. The value
# comes from variable `$2` if it is set, else from environment variable
# `$3`. An empty value gives the default `$4`. Any other value must match
# one of the space-separated values in `$5`, in any case, and gives that
# value as `$5` writes it; else this stops with an error and the usage.
# Warns when the option ends the arguments without its value.
function canonical_value {
    local name="$1"
    local value="${!2-}"
    if [[ -z ${!2+set} ]]; then
        name="$3"
        value="${!3-}"
    fi
    if [[ ${expecting_value_of} == "$2" ]]; then
        local from="${name}=${value}"
        if [[ -z ${value} ]]; then
            from="the default"
        fi
        echo "WARNING: $1 needs a value; using" >&2
        echo "  ${from}" >&2
    fi
    option_value="$4"
    if [[ -n ${value} ]]; then
        option_value=
        local canonical
        shopt -s nocasematch
        for canonical in $5; do
            if [[ ${value} == "${canonical}" ]]; then
                option_value="${canonical}"
            fi
        done
        shopt -u nocasematch
    fi
    if [[ -z ${option_value} ]]; then
        echo "ERROR: unknown value '${value}' for ${name}" >&2
        usage
        exit 1
    fi
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

# Reconstruct argument list to forward to tool
args=()
# The variable that takes the next argument, the value of an option
expecting_value_of=
# Only the arguments set these, not environment variables of the same
# names; canonical_value reads an unset option variable as not given
tool=
force_lang=
version=false
show=false
build_uses_salt_flang=false
unset excluded_main_setup parse_excluded_modules
for arg in "$@"; do
    #echo "working on arg: $arg"
    if [[ -n ${expecting_value_of} ]]; then
        printf -v "${expecting_value_of}" '%s' "${arg}"
        if [[ ${expecting_value_of} == forwarded_value ]]; then
            args+=("$arg")
        fi
        expecting_value_of=
    elif [[ $arg == --lang=* ]]; then
        lang="${arg#--lang=}"
        case "${lang}" in
            fortran|Fortran)
                force_lang=fortran
                tool=fparse-llvm
            ;;
            c|C|cxx|CXX|c++|C++)
                force_lang=c
                tool=cparse-llvm
            ;;
            *)
                echo "Invalid language specified: $lang"
                exit 1
            ;;
        esac
    elif [[ $arg == --help || $arg == -h ]]; then
        if [[ -n "${force_lang:-}" ]]; then
            "${_SCRIPT_DIR}/${tool}" --help
        else
            usage
        fi
        exit 0
    elif [[ $arg == --help-fortran ]]; then
        "${_SCRIPT_DIR}/fparse-llvm" --help
        exit 0
    elif [[ $arg == --help-c || $arg == --help-cxx ]]; then
        "${_SCRIPT_DIR}/cparse-llvm" --help
        exit 0
    elif [[ $arg == --version ]]; then
        version=true
    # The tool takes the next argument as the value of these options, so
    # it names no source; LLVM's option parser also takes one dash
    elif [[ $arg =~ ^--?(config_file|flang_exe|tau_output|tau_select_file)$ ]]; then
        args+=("$arg")
        expecting_value_of=forwarded_value
    # The Fortran extensions that Flang or gfortran read, but not in an
    # option value, such as --tau_output=out.inst.f08
    elif [[ $arg != -* && $arg =~ \.(f|F|for|FOR|ftn|FTN|f77|fpp|FPP|[fF](90|95|03|08|18))$ ]]; then
        args+=("$arg")
        if [[ -z "${tool:-}" ]]; then
            tool=fparse-llvm
        fi
    elif [[ $arg != -* && ($arg == *.[cC] || $arg == *.[cC][cC] || $arg == *.cpp || $arg == *.CPP) ]]; then
        args+=("$arg")
        if [[ -z "${tool:-}" ]]; then
            tool=cparse-llvm
        fi
    elif [[ $arg == --show ]]; then
        show=true
    elif [[ $arg == --tau_excluded_main_setup ]]; then
        expecting_value_of=excluded_main_setup
    elif [[ $arg == --tau_excluded_main_setup=* ]]; then
        # canonical_value reads it by name
        # shellcheck disable=SC2034
        excluded_main_setup="${arg#*=}"
    elif [[ $arg == --tau_parse_excluded_modules ]]; then
        expecting_value_of=parse_excluded_modules
    elif [[ $arg == --tau_parse_excluded_modules=* ]]; then
        # canonical_value reads it by name
        # shellcheck disable=SC2034
        parse_excluded_modules="${arg#*=}"
    elif [[ $arg == --tau_build_uses_salt_flang ]]; then
        build_uses_salt_flang=true
    else
        args+=("$arg")
    fi
done

if [[ "${version:-false}" == "true" ]]; then
    echo "SALT-FM Version: ${_VERSION}"
    if [[ "${tool:-}" == fparse-llvm ]]; then
        # Forward the arguments so --flang_exe selects the driver
        "${_SCRIPT_DIR}/${tool}" --version ${args[@]+"${args[@]}"}
    elif [[ -n "${tool:-}" ]]; then
        "${_SCRIPT_DIR}/${tool}" --version
    fi
    exit 0
fi

if [[ -z "${tool:-}" ]]; then
    echo "No source files provided, language not detected."
    exit 1
fi

canonical_value --tau_excluded_main_setup excluded_main_setup SALT_EXCLUDED_MAIN_SETUP \
    routine "none routine file"
# Before the arguments, which can end with `--` and compiler options
args=("--tau_excluded_main_setup=${option_value}" ${args[@]+"${args[@]}"})
if [[ ${tool} == fparse-llvm ]]; then
    canonical_value --tau_parse_excluded_modules parse_excluded_modules SALT_PARSE_EXCLUDED_MODULES \
        modules-only "off modules-only submodules-and-modules"
    args=("--tau_parse_excluded_modules=${option_value}" "${args[@]}")
    if $build_uses_salt_flang; then
        args=(--tau_build_uses_salt_flang "${args[@]}")
    fi
fi

# Check if the tool exists
if [[ ! -f "${_SCRIPT_DIR}/${tool}" ]]; then
    echo "Tool not found: ${_SCRIPT_DIR}/${tool}"
    exit 1
fi

# Print the command line that would be executed by the outter wrapper script
# if the --show flag is set
if [[ "${show:-false}" == "true" ]]; then
    if [[ "${tool}" == "fparse-llvm" ]]; then
        echo "$tool --show ${args[*]:-}"
        # fparse-llvm is also a wrapper script with a --show flag
        # so print the command line that would be executed by the inner wrapper script
        # if the language is Fortran
        "${_SCRIPT_DIR}/fparse-llvm" --show ${args[@]+"${args[@]}"}
    else
        echo "$tool ${args[*]:-}"
    fi
    exit 0
fi

# Execute the tool with the arguments
"${_SCRIPT_DIR}/${tool}" ${args[@]+"${args[@]}"}
