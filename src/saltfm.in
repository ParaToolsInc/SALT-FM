# This script determines whether to call the SALT-FM C/C++ or Fortran instrumentor
# based on the file extension of the input source file or the --lang option.

set -o errexit
set -o nounset
set -o pipefail
#set -o verbose
#set -o xtrace

readonly _VERSION="@SALT_VERSION_FULL@"
# get the absolute path of this script, without `dirname`; a `\` also
# separates directories, as under MSYS
case ${BASH_SOURCE[0]} in
    */* | *\\*) _SCRIPT_DIR="${BASH_SOURCE[0]%[/\\]*}" ;;
    *) _SCRIPT_DIR=. ;;
esac
_SCRIPT_DIR="$(cd "${_SCRIPT_DIR:-/}" && pwd)"
readonly _SCRIPT_DIR

read -r -d '' _USAGE <<EOF || true
OVERVIEW: Tool for adding TAU instrumentation to source files.
Note that this will only instrument the first source file given.
USAGE: $0 [options] <source0> [... <sourceN>]

OPTIONS:

Generic SALT-FM Options:

  -h                            - Alias for --help
  --help                        - Display available options (--help-hidden for more)
  --help-fortran                - Display Fortran instrumentor options and usage information
  --help-c                      - Display C/C++ instrumentor options and usage information
  --help-cxx                    - Display C/C++ instrumentor options and usage information
  --version                     - Display the version of this program
  --lang=<string>               - Specify the language of the input source file (default: auto-detect)
  --show                        - Print the command line that would be executed by the outter wrapper script

TAU instrumentor options:

  --config_file=<filename>      - Specify path to SALT-FM configuration YAML file
  --flang_exe=<path>            - Flang driver for Fortran (default: \$SALT_FLANG_EXE, else the one SALT-FM was built with)
  --tau_allow_parse_errors      - C and C++ only: instrument the partial parse tree that Clang builds after errors (default: \$SALT_ALLOW_PARSE_ERRORS, else false)
  --tau_fabricate_unknown_types - Fabricate declarations for unknown qualified names (default: false)
  --tau_instrument_inline       - Instrument inlined functions (default: false)
  --tau_main_setup_parse_level=<level>
                                - never, function, or always: when to parse a source that the file
                                  lists exclude and to give main its setup code without a timer
                                  (default: \$SALT_MAIN_SETUP_PARSE_LEVEL, else function)
  --tau_parse_excluded_modules=<on|off>
                                - Fortran only: parse a source that the file lists exclude when it
                                  seems to define a module, for its module files, below the always
                                  level (default: \$SALT_PARSE_EXCLUDED_MODULES, else on)
  --tau_output=<filename>       - Specify name of output instrumented file
  --tau_select_file=<filename>  - Provide a selective instrumentation specification file
  --tau_use_cxx_api             - Use TAU's C++ instrumentation API
EOF

# Add a help/usage message function
function usage {
    echo "$_USAGE"
}

# Sets `level` to the canonical level of option `$1`, whose value is in
# variable `$2` if it is set, else in environment variable `$3`: never,
# function (also for an empty value), or always, in any case. Stops with
# an error and the usage for any other value, or a level not in `$4`.
# Warns when the option ends the arguments without its value.
function canonical_level {
    local name="$1"
    local value="${!2-}"
    if [[ -z ${!2+set} ]]; then
        name="$3"
        value="${!3-}"
    fi
    if [[ ${expecting_value_of} == "$2" ]]; then
        local from="${name}=${value}"
        if [[ -z ${value} ]]; then
            from="the default"
        fi
        echo "WARNING: $1 needs a value; using" >&2
        echo "  ${from}" >&2
    fi
    shopt -s nocasematch
    case ${value} in
        never | no | off | false | 0) level=never ;;
        '' | function | procedure | default | medium | yes | on | true | 1) level=function ;;
        always | file | force | all) level=always ;;
        *) level= ;;
    esac
    shopt -u nocasematch
    if [[ " $4 " != *" ${level} "* ]]; then
        echo "ERROR: unknown value '${value}' for ${name}" >&2
        usage
        exit 1
    fi
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

# Reconstruct argument list to forward to tool
args=()
# The variable that takes the next argument, the value of an option
expecting_value_of=
for arg in "$@"; do
    #echo "working on arg: $arg"
    if [[ -n ${expecting_value_of} ]]; then
        printf -v "${expecting_value_of}" '%s' "${arg}"
        expecting_value_of=
    elif [[ $arg == --lang=* ]]; then
        lang="${arg#--lang=}"
        case "${lang}" in
            fortran|Fortran)
                force_lang=fortran
                tool=fparse-llvm
            ;;
            c|C|cxx|CXX|c++|C++)
                force_lang=c
                tool=cparse-llvm
            ;;
            *)
                echo "Invalid language specified: $lang"
                exit 1
            ;;
        esac
    elif [[ $arg == --help || $arg == -h ]]; then
        if [[ -n "${force_lang:-}" ]]; then
            "${_SCRIPT_DIR}/${tool}" --help
        else
            usage
        fi
        exit 0
    elif [[ $arg == --help-fortran ]]; then
        "${_SCRIPT_DIR}/fparse-llvm" --help
        exit 0
    elif [[ $arg == --help-c || $arg == --help-cxx ]]; then
        "${_SCRIPT_DIR}/cparse-llvm" --help
        exit 0
    elif [[ $arg == --version ]]; then
        version=true
    elif [[ $arg == *.[Ff]90 || $arg == *.[Ff] || $arg == *.[Ff]03 ]]; then
        args+=("$arg")
        if [[ -z "${tool:-}" ]]; then
            tool=fparse-llvm
        fi
    elif [[ $arg == *.[cC] || $arg == *.[cC][cC] || $arg == *.cpp || $arg == *.CPP ]]; then
        args+=("$arg")
        if [[ -z "${tool:-}" ]]; then
            tool=cparse-llvm
        fi
    elif [[ $arg == --show ]]; then
        show=true
    elif [[ $arg == --tau_main_setup_parse_level ]]; then
        expecting_value_of=main_setup_level
    elif [[ $arg == --tau_main_setup_parse_level=* ]]; then
        # canonical_level reads it by name
        # shellcheck disable=SC2034
        main_setup_level="${arg#*=}"
    elif [[ $arg == --tau_parse_excluded_modules ]]; then
        expecting_value_of=parse_excluded_modules
    elif [[ $arg == --tau_parse_excluded_modules=* ]]; then
        # canonical_level reads it by name
        # shellcheck disable=SC2034
        parse_excluded_modules="${arg#*=}"
    else
        args+=("$arg")
    fi
done

if [[ "${version:-false}" == "true" ]]; then
    echo "SALT-FM Version: ${_VERSION}"
    if [[ "${tool:-}" == fparse-llvm ]]; then
        # Forward the arguments so --flang_exe selects the driver
        "${_SCRIPT_DIR}/${tool}" --version ${args[@]+"${args[@]}"}
    elif [[ -n "${tool:-}" ]]; then
        "${_SCRIPT_DIR}/${tool}" --version
    fi
    exit 0
fi

if [[ -z "${tool:-}" ]]; then
    echo "No source files provided, language not detected."
    exit 1
fi

canonical_level --tau_main_setup_parse_level main_setup_level SALT_MAIN_SETUP_PARSE_LEVEL \
    "never function always"
# Before the arguments, which can end with `--` and compiler options
args=("--tau_main_setup_parse_level=${level}" ${args[@]+"${args[@]}"})
if [[ ${tool} == fparse-llvm ]]; then
    # The values of the `function` level turn it on, and those of `never` off
    canonical_level --tau_parse_excluded_modules parse_excluded_modules SALT_PARSE_EXCLUDED_MODULES \
        "never function"
    modules=on
    if [[ ${level} == never ]]; then
        modules=off
    fi
    args=("--tau_parse_excluded_modules=${modules}" "${args[@]}")
fi

# Check if the tool exists
if [[ ! -f "${_SCRIPT_DIR}/${tool}" ]]; then
    echo "Tool not found: ${_SCRIPT_DIR}/${tool}"
    exit 1
fi

# Print the command line that would be executed by the outter wrapper script
# if the --show flag is set
if [[ "${show:-false}" == "true" ]]; then
    if [[ "${tool}" == "fparse-llvm" ]]; then
        echo "$tool --show ${args[*]:-}"
        # fparse-llvm is also a wrapper script with a --show flag
        # so print the command line that would be executed by the inner wrapper script
        # if the language is Fortran
        "${_SCRIPT_DIR}/fparse-llvm" --show ${args[@]+"${args[@]}"}
    else
        echo "$tool ${args[*]:-}"
    fi
    exit 0
fi

# Execute the tool with the arguments
"${_SCRIPT_DIR}/${tool}" ${args[@]+"${args[@]}"}
