set -o errexit
set -o nounset
set -o pipefail
#set -o verbose
#set -o xtrace

readonly _SALTFM_PLUGIN_SO="libsalt-flang-plugin@CMAKE_SHARED_LIBRARY_SUFFIX@"
readonly _VERSION="@SALT_VERSION_FULL@"
readonly _SALT_MOD_SUFFIX=@SALT_MOD_SUFFIX@
# Flang driver and LLVM major version that SALT-FM was built with
readonly _RECORDED_FLANG_EXE="@salt_flang_driver@"
readonly _LLVM_VERSION_MAJOR=@LLVM_VERSION_MAJOR@

# get the absolute path of this script, without `dirname`; a `\` also
# separates directories, as under MSYS
case ${BASH_SOURCE[0]} in
    */* | *\\*) _SCRIPT_DIR="${BASH_SOURCE[0]%[/\\]*}" ;;
    *) _SCRIPT_DIR=. ;;
esac
_SCRIPT_DIR="$(cd "${_SCRIPT_DIR:-/}" && pwd)"
readonly _SCRIPT_DIR
readonly _SALT_INC_DIR="${_SCRIPT_DIR}/../@SALT_INC_DIR@"

SALT_PLUGIN_SO="${_SCRIPT_DIR}/../@CMAKE_INSTALL_LIBDIR@/${_SALTFM_PLUGIN_SO}"

read -r -d '' _USAGE <<EOF || true
OVERVIEW: Tool for adding TAU instrumentation to source files.
Note that this will only instrument the first source file given.
USAGE: $0 [options] <source0> [... <sourceN>]

OPTIONS:

Generic Options:

  -h                           - Alias for --help
  --help                       - Display available options
  --version                    - Display the version of this program

TAU instrumentor options:

  --config_file=<filename>     - Specify path to SALT-FM configuration YAML file (default: \$SALT_CONFIG_FILE, else the installed config.yaml)
  --flang_exe=<path>           - Flang driver to run (default: \$SALT_FLANG_EXE, else the one SALT-FM was built with)
  --tau_excluded_main_setup=<none|routine|file>
                               - Selects which excluded main programs get setup code.
                                 Setup code makes sure that the measurement library
                                 starts correctly. We recommend it for all programs.
                                   none:    No excluded main program gets setup code.
                                   routine: A main program that the routine lists
                                            exclude gets setup code. This is the
                                            default.
                                   file:    A main program in a file that the file
                                            lists exclude also gets setup code. This
                                            makes SALT-FM parse all excluded files.
                                            SALT-FM adds setup code to each main
                                            program that it finds, but it adds no
                                            timers to these files.
                                 (default: routine)
  --tau_parse_excluded_modules=<off|modules-only|submodules-and-modules>
                               - Fortran only. Selects which excluded files SALT-FM
                                 parses to write their module files. SALT-FM needs
                                 these module files to instrument the files that use
                                 the modules. It adds no timers to the excluded files.
                                   off:          SALT-FM parses no excluded file.
                                   modules-only: SALT-FM parses an excluded file that
                                                 defines a module, or has an INCLUDE
                                                 line or #include. This is the
                                                 default.
                                   submodules-and-modules:
                                                 SALT-FM also parses an excluded file
                                                 that has only submodules. Only the
                                                 child submodules of a submodule need
                                                 its module file.
                                 With --tau_excluded_main_setup=file, SALT-FM parses all
                                 files, and this option has no effect.
                                 (default: modules-only)
  --tau_output=<filename>      - Specify name of output instrumented file
  --tau_select_file=<filename> - Provide a selective instrumentation specification file
  --show                       - Print the command line that would be executed by the wrapper script
EOF

# Add a help/usage message function
function usage {
    echo "$_USAGE"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

# Set a whitelist of flags that can be passed to the flang frontend plugin
# This is where libtooling for flang could help
# List derived from output of `flang-new -fc1 -help`
declare -a -r _WHITELISTED_FLAGS=(
  -cpp
  -dM
  -E
  -falternative-parameter-statement
  -fbackslash
  -fcolor-diagnostics
  -ffixed-form
  -ffree-form
  -fimplicit-none
  -flogical-abbreviations
  -fno-reformat
  -fopenacc
  -fopenmp-is-target-device
  -fopenmp-target-debug
  -fopenmp
  -fsyntax-only
  -funderscoring
  -fxor-operator
  -help
  -init-only
  -nocpp
  -pedantic
  -pthread
  -P
  -save-temps
  -S
  -version
  -w
  "-ffixed-line-length=.*"
  "-finput-charset=.*"
  "-fopenmp-version=.*"
  "-save-temps=.*"
  "-std=.*"
)
_WHITELISTED_REGEX="(${_WHITELISTED_FLAGS[0]})"
# Loop over the secend element of _WHITELISTED_FLAGS to the end and add them to the regex
for flag in "${_WHITELISTED_FLAGS[@]:1}"; do
    _WHITELISTED_REGEX="${_WHITELISTED_REGEX}|(${flag})"
done
declare -r -a _BLACKLISTED_FLAGS=(
    "^-Wl,.*"
    '^--$'
)
_BLACKLISTED_REGEX="(${_BLACKLISTED_FLAGS[0]})"
for flag in "${_BLACKLISTED_FLAGS[@]:1}"; do
    _BLACKLISTED_REGEX="${_BLACKLISTED_REGEX}|(${flag})"
done
declare -r -a _WHITELISTED_FLAGS_WARNING_ARG=(
    "-W[^l].*"
)
_WHITELISTED_WARNING_REGEX="(${_WHITELISTED_FLAGS_WARNING_ARG[0]})"
for flag in "${_WHITELISTED_FLAGS_WARNING_ARG[@]:1}"; do
    _WHITELISTED_WARNING_REGEX="${_WHITELISTED_WARNING_REGEX}|(${flag})"
done
# Only a whole flag matches, not a name such as my-Wstuff.f95
_WHITELISTED_WARNING_REGEX="^(${_WHITELISTED_WARNING_REGEX})$"
declare -r -a _WHITELISTED_FLAGS_MAYBE_SPACE_ARG=(
    "-I"
    "-J"
    "-D"
    "-U"
)
for flag in "${_WHITELISTED_FLAGS_MAYBE_SPACE_ARG[@]}"; do
    _WHITELISTED_REGEX="${_WHITELISTED_REGEX}|(${flag}.+)"
done
# Only a whole flag matches, not a name such as my-Stuff.f95
_WHITELISTED_REGEX="^(${_WHITELISTED_REGEX})$"

declare -r -a _WHITELISTED_FLAGS_YES_SPACE_ARG=(
    "-module-dir"
    "-module-suffix"
    "-x"
)
_WHITELISTED_OPT_ARG_REGEX="(${_WHITELISTED_FLAGS_YES_SPACE_ARG[0]})"
for flag in "${_WHITELISTED_FLAGS_YES_SPACE_ARG[@]:1}"; do
    _WHITELISTED_OPT_ARG_REGEX="${_WHITELISTED_OPT_ARG_REGEX}|(${flag})"
done
for flag in "${_WHITELISTED_FLAGS_MAYBE_SPACE_ARG[@]}"; do
    _WHITELISTED_OPT_ARG_REGEX="${_WHITELISTED_OPT_ARG_REGEX}|(${flag})"
done
# Only the whole flag takes the next argument, not a name such as other-x.f95
_WHITELISTED_OPT_ARG_REGEX="^(${_WHITELISTED_OPT_ARG_REGEX})$"

# echo "WHITELISTED_REGEX: ${_WHITELISTED_REGEX}"
# echo "BLACKLISTED_REGEX: ${_BLACKLISTED_REGEX}"
# echo "WHITELISTED_WARNING_REGEX: ${_WHITELISTED_WARNING_REGEX}"
# echo "WHITELISTED_OPT_ARG_REGEX: ${_WHITELISTED_OPT_ARG_REGEX}"


# Loop over the arguments and check for the output file -o flag and it's argument
# If found, set the output file name to the argument following the -o flag and remove the -o flag and argument from the argument list
# If not found, set the output file name to the first argument with a .inst extension
#echo "Passed command line arguments: $*"

# The arguments that can name an input: all but the output file and the
# values forwarded after a flag
inputs=()
# The arguments that are not flags and have no Fortran extension
others=()
args=()
expecting_arg_to_forward=false
expecting_output_file=false
expecting_config_file=false
expecting_select_file=false
expecting_flang_exe=false
expecting_excluded_main_setup=false
expecting_parse_excluded_modules=false
# Only the arguments set these, not environment variables of the same names
unset FORTRAN_CONFIG_FILE flang_exe input_file output_file select_file
excluded_main_setup=routine
parse_excluded_modules=modules-only
show=false
version=false
for arg in "$@"; do
    #echo "working on arg: $arg"
    if [[ $arg == --help || $arg == -h ]]; then
        usage
        exit 0
    elif [[ $arg == --version ]]; then
        version=true
        shift || true
    elif $expecting_arg_to_forward; then
        args+=("$arg")
        expecting_arg_to_forward=false
        shift
        continue
        #echo "args remaining: $*"
    elif $expecting_output_file; then
        output_file="$arg"
        expecting_output_file=false
        shift
        continue
        #echo "args remaining: $*"
    elif $expecting_config_file; then
        FORTRAN_CONFIG_FILE="$arg"
        expecting_config_file=false
        shift
        #echo "args remaining: $*"
    elif $expecting_select_file; then
        select_file="$arg"
        expecting_select_file=false
        shift
        #echo "args remaining: $*"
    elif $expecting_flang_exe; then
        flang_exe="$arg"
        expecting_flang_exe=false
        shift
    elif $expecting_excluded_main_setup; then
        excluded_main_setup="$arg"
        expecting_excluded_main_setup=false
        shift
        continue
    elif $expecting_parse_excluded_modules; then
        parse_excluded_modules="$arg"
        expecting_parse_excluded_modules=false
        shift
        continue
    elif [[ $arg == --flang_exe ]]; then
        expecting_flang_exe=true
        shift || true
    elif [[ $arg == --flang_exe=* ]]; then
        flang_exe="${arg#--flang_exe=}"
        shift || true
    elif [[ $arg == --tau_excluded_main_setup ]]; then
        expecting_excluded_main_setup=true
        shift || true
    elif [[ $arg == --tau_excluded_main_setup=* ]]; then
        excluded_main_setup="${arg#*=}"
        shift || true
    elif [[ $arg == --tau_parse_excluded_modules ]]; then
        expecting_parse_excluded_modules=true
        shift || true
    elif [[ $arg == --tau_parse_excluded_modules=* ]]; then
        parse_excluded_modules="${arg#*=}"
        shift || true
    elif [[ $arg == --tau_output ]]; then
        expecting_output_file=true
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --tau_output=* ]]; then
        output_file="${arg#--tau_output=}"
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --tau_select_file ]]; then
        expecting_select_file=true
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --tau_select_file=* ]]; then
        select_file="${arg#--tau_select_file=}"
        shift || true
        #echo "args remaining: $*"
    # The Fortran extensions that Flang or gfortran read, as saltfm
    elif [[ $arg =~ \.(f|F|for|FOR|ftn|FTN|f77|fpp|FPP|[fF](90|95|03|08|18))$ ]]; then
        input_file="$arg"
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --show ]]; then
        show=true
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --config_file ]]; then
        expecting_config_file=true
        shift || true
        #echo "args remaining: $*"
    elif [[ $arg == --config_file=* ]]; then
        FORTRAN_CONFIG_FILE="${arg#--config_file=}"
        shift || true
        #echo "args remaining: $*"
    # Begin sanitizing options/flags that cause the frontend plugin to throw an error
    elif [[ ${arg:-} =~ $_BLACKLISTED_REGEX ]]; then
        shift || true
        echo "Removed blacklisted flag: $arg"
    elif [[ "${arg:-}" =~ $_WHITELISTED_WARNING_REGEX ]]; then
        # Only safe to do after ensuring -Wl,* blacklisted flag is removed
        if [[ "${arg:-}" == -Werror ]]; then
            args+=("$arg")
        fi
        # Flang frontend doesn't (yet) support -Wall, -Wextra, etc. only -Werror, so throw others away
        shift || true
        #echo "Added whitelisted warning flag: $arg"
    elif [[ ${arg:-} =~ ${_WHITELISTED_REGEX} ]]; then
        args+=("$arg")
        shift || true
        #echo "Added whitelisted flag: $arg"
    elif [[ ${arg:-} =~ ${_WHITELISTED_OPT_ARG_REGEX} ]]; then
        args+=("$arg")
        expecting_arg_to_forward=true
        shift || true
        #echo "Added whitelisted flag with argument: $arg"
    elif [[ $arg != -* ]]; then
        # The first one is the input file if no argument has a Fortran
        # extension
        others+=("$arg")
        shift || true
    else
        echo "Removed unknown flag: $arg"
        shift || true
    fi
    inputs+=("$arg")
done

# --config_file, then SALT_CONFIG_FILE unless it is empty, then the installed
# one
FORTRAN_CONFIG_FILE="${FORTRAN_CONFIG_FILE-${SALT_CONFIG_FILE:-${_SCRIPT_DIR}/../@CMAKE_INSTALL_DATADIR@/@CMAKE_PROJECT_NAME@/config_files/config.yaml}}"

# Opening the output would empty an input it names, such as an argument or the
# config or selective instrumentation file, so refuse it before anything is
# written; the loop above sets the roles, so argument order cannot skip one
for arg in "${FORTRAN_CONFIG_FILE}" "${select_file:-}" ${inputs[@]+"${inputs[@]}"}; do
    if [[ ${output_file:-} -ef ${arg} ]]; then
        echo "ERROR: Output file ${output_file} is an input file" >&2
        exit 1
    fi
done
# TAU's compiler wrapper compiles any file left at this path, even a stale one,
# so remove it before anything can fail. Skip a read-only file; the open for
# writing then fails and saltfm exits with an error
if ! $show && ! $version && [[ -f ${output_file:-} && -w ${output_file} ]] &&
    ! rm_err="$(rm -f -- "${output_file}" 2>&1)"; then
    echo "ERROR: Could not remove output file ${output_file}: ${rm_err##*: }" >&2
    exit 1
fi

if $expecting_excluded_main_setup; then
    echo "WARNING: --tau_excluded_main_setup needs a value; using ${excluded_main_setup}" >&2
fi
if $expecting_parse_excluded_modules; then
    echo "WARNING: --tau_parse_excluded_modules needs a value; using ${parse_excluded_modules}" >&2
fi
case ${excluded_main_setup} in
    none | routine | file) ;;
    *)
        echo "ERROR: unknown value '${excluded_main_setup}' for --tau_excluded_main_setup" >&2
        exit 1
        ;;
esac
case ${parse_excluded_modules} in
    off | modules-only | submodules-and-modules) ;;
    *)
        echo "ERROR: unknown value '${parse_excluded_modules}' for --tau_parse_excluded_modules" >&2
        exit 1
        ;;
esac
if $expecting_flang_exe || [[ -n ${flang_exe+set} && -z ${flang_exe} ]]; then
    echo "ERROR: --flang_exe needs a path" >&2
    exit 1
fi
if $expecting_config_file || [[ -z ${FORTRAN_CONFIG_FILE} ]]; then
    echo "ERROR: --config_file needs a path" >&2
    exit 1
fi
# Select the Flang driver: --flang_exe, then SALT_FLANG_EXE, then the
# driver SALT-FM was built with, then flang or flang-new on PATH
flang_exe_override="${flang_exe:-${SALT_FLANG_EXE:-}}"
flang_exe="${flang_exe_override}"
if [[ -z "${flang_exe}" ]]; then
    if [[ -f "${_RECORDED_FLANG_EXE}" && -x "${_RECORDED_FLANG_EXE}" ]]; then
        flang_exe="${_RECORDED_FLANG_EXE}"
    else
        # Empty when configure found no driver
        if [[ -n "${_RECORDED_FLANG_EXE}" ]]; then
            echo "WARNING: recorded Flang driver '${_RECORDED_FLANG_EXE}' is missing" >&2
            echo "or not executable; searching PATH for flang and flang-new." >&2
        fi
        flang_exe="$(type -P flang || type -P flang-new || true)"
    fi
fi
if [[ -z "${flang_exe}" ]]; then
    echo "ERROR: no flang or flang-new on PATH. Select a Flang ${_LLVM_VERSION_MAJOR} driver" >&2
    echo "with --flang_exe=<path> or SALT_FLANG_EXE." >&2
    exit 1
fi
# The plugin only loads into the LLVM major version it was built with
flang_version="$("${flang_exe}" --version || true)"
flang_major=unknown
if [[ ${flang_version%%$'\n'*} =~ version\ ([0-9]+)\. ]]; then
    flang_major="${BASH_REMATCH[1]}"
fi
if [[ ${flang_major} != "${_LLVM_VERSION_MAJOR}" ]]; then
    echo "ERROR: Flang driver '${flang_exe}' has LLVM major version ${flang_major}," >&2
    echo "but SALT-FM was built with LLVM ${_LLVM_VERSION_MAJOR}. Select a Flang ${_LLVM_VERSION_MAJOR} driver with" >&2
    echo "--flang_exe=<path> or SALT_FLANG_EXE." >&2
    exit 1
fi
if [[ ${flang_exe_override##*/} == flang-new && ${flang_major} -ge 20 ]]; then
    echo "Note: flang-new is an old name for the Flang ${flang_major} driver; use flang" >&2
fi
if $version; then
    echo "SALT-FM Version: ${_VERSION}"
    echo "${flang_version}"
    exit 0
fi

#echo "args: \"${args[*]}\""
# print the argument list
if [[ -z "${input_file:-}" && ${#others[@]} -gt 0 ]]; then
    input_file="${others[0]}"
    others=("${others[@]:1}")
fi
for arg in ${others[@]+"${others[@]}"}; do
    echo "Removed unknown flag: $arg"
done
# Flang -fc1 reads .ftn and .FTN as free form, unlike gfortran, and does not
# preprocess .FTN; a later flag in the arguments overrides these
case ${input_file:-} in
    *.ftn) args=(-ffixed-form ${args[@]+"${args[@]}"}) ;;
    *.FTN) args=(-ffixed-form -cpp ${args[@]+"${args[@]}"}) ;;
esac

echo "input file: ${input_file:-\"<None given>\" }"

# If no output file is given, emit the output file in the current working directory
if [[ -z "${output_file:-}" ]]; then
    if [[ ${input_file:-none} == *.* ]]; then
      file_ext=".${input_file##*.}"
    else
        file_ext=""
    fi
    # The output has preprocessor directives, so give it the extension of a
    # preprocessed source of the same form that gfortran and Flang read
    case ${file_ext} in
        .[fF]90 | .[fF]95 | .[fF]03 | .[fF]08 | .[fF]18) file_ext=.F90 ;;
        .f | .F | .for | .FOR | .ftn | .FTN | .f77 | .fpp | .FPP) file_ext=.F ;;
        *) file_ext="${file_ext//f/F}" ;;
    esac
    if [[ "${input_file:-none}" == */* ]]; then
        output_file="${input_file%.*}.inst${file_ext}"
        output_file="$(pwd)/${output_file##*/}"
    else
        output_file="$(pwd)/${input_file:+${input_file%.*}}.inst${file_ext}"
    fi

fi

echo "output file: ${output_file:-\"<None given>\" }"
echo "Remaining Arguments: ${args[*]:-}"

# This script invokes an LLVM flang frontend plugin to parse and instrument Fortran code
cmd=("${flang_exe}"
    -fc1
    -load "${SALT_PLUGIN_SO}"
    -plugin salt-instrument
    -module-suffix "${_SALT_MOD_SUFFIX}"
    # Flang 23+ resolves `use, intrinsic` only from intrinsic module paths;
    # on Flang 19-22 the plugin adds these directories to them
    -fintrinsic-modules-path "${_SALT_INC_DIR}"
    "${input_file:-}"
    -o "${output_file}"
    ${args[@]+"${args[@]}"})
echo "SALT_FORTRAN_CONFIG_FILE=\"${FORTRAN_CONFIG_FILE}\""
echo "SALT_FORTRAN_SELECT_FILE=\"${select_file:-}\""
echo "SALT_FORTRAN_EXCLUDED_MAIN_SETUP=${excluded_main_setup}"
if $show; then
    echo "cmd: ${cmd[*]}"
    exit 0
fi
# With no input file, Flang would read stdin
if [[ -z ${input_file+set} ]]; then
    echo "ERROR: no input file" >&2
    exit 1
fi

# Runs Flang with the plugin
function run_flang {
    echo "Running: ${cmd[*]}"
    SALT_FORTRAN_SELECT_FILE="${select_file:-}" SALT_FORTRAN_CONFIG_FILE="${FORTRAN_CONFIG_FILE}" \
        SALT_FORTRAN_EXCLUDED_MAIN_SETUP="${excluded_main_setup}" "${cmd[@]}"
}

# Returns whether `content` matches regex `$1`, in the C locale: in a
# UTF-8 locale, a byte that is not valid UTF-8, as in Latin-1 text, can
# stop the match
function content_matches {
    local LC_ALL=C
    [[ ${content} =~ $1 ]]
}

# Unless --tau_excluded_main_setup=file, copy a source that the file lists
# exclude without a parse, unless it seems to define a module, whose
# module files other sources need, or holds an INCLUDE line or an
# `#include`, whose text can; with submodules-and-modules, also unless it
# seems to define a submodule, whose module file only its child
# submodules need. The plugin repeats the SIF warnings when Flang runs.
sif_status=0
if [[ -n ${select_file:-} && ${excluded_main_setup} != file ]]; then
    sif_log="$("${_SCRIPT_DIR}/salt-selectfile" "${select_file}" "${input_file}" 2>&1)" ||
        sif_status=$?
fi
if [[ ${sif_status} -eq 1 ]]; then
    # One match on the whole text, with a newline in place of `^`, since a
    # loop with `read` on each line is ten times slower. A line matches
    # after blanks (a space or a tab) and a statement label, so comment
    # lines do not. A module statement ends after the name, so a separate
    # module procedure or a module procedure statement does not match.
    nl=$'\n'
    cr=$'\r'
    module_re="${nl}[[:blank:]]*([0-9]+[[:blank:]]+)?module[[:blank:]]+[[:alpha:]][[:alnum:]_]*"
    module_re+="[[:blank:]${cr}]*(${nl}|[!;]|\$)"
    submodule_re="${nl}[[:blank:]]*([0-9]+[[:blank:]]+)?submodule[[:blank:]]*\("
    include_re="${nl}[[:blank:]]*(#[[:blank:]]*)?include[[:blank:]]*[\"'<]"
    program_re="${nl}[[:blank:]]*([0-9]+[[:blank:]]+)?program[[:blank:]]+[[:alpha:]]"
    if [[ ! -r ${input_file} ]]; then
        echo "ERROR: Could not open input file ${input_file}" >&2
        exit 1
    fi
    content="$(<"${input_file}")"
    # Flang accepts a UTF-8 byte order mark before the first line
    content="${nl}${content#$'\xef\xbb\xbf'}"
    # module, include (an include line but no module), submodule, or empty
    # for none of them
    kind=
    shopt -s nocasematch
    if content_matches "${program_re}"; then
        echo "WARNING: ${input_file} seems to contain the main program. The file lists" >&2
        echo "  exclude this file, so the main program gets no setup code. To add the" >&2
        echo "  setup code, use --tau_excluded_main_setup=file." >&2
    fi
    if content_matches "${module_re}"; then
        kind=module
    elif content_matches "${include_re}"; then
        kind=include
    elif content_matches "${submodule_re}"; then
        kind=submodule
    fi
    shopt -u nocasematch
    case ${parse_excluded_modules}:${kind} in
        modules-only:module | modules-only:include | submodules-and-modules:?*) parse=true ;;
        *) parse=false ;;
    esac
    mod_files="its module files"
    can_fail="sources that use its modules can fail"
    if [[ ${kind} == include ]]; then
        # The included text may define no module
        mod_files="any module files it defines"
        can_fail="sources that use them can fail"
    elif [[ ${kind} == submodule ]]; then
        # Nothing can `use` a submodule; only its child submodules need it
        can_fail="child submodules of its submodules can fail"
    fi
    if $parse; then
        if [[ ${excluded_main_setup} == none ]]; then
            echo "WARNING: parsing ${input_file}, which the selective instrumentation" >&2
            echo "  file lists exclude, for ${mod_files}" >&2
            echo "  (--tau_parse_excluded_modules=off skips the parse)" >&2
        fi
        if run_flang; then
            exit 0
        fi
        # Flang stopped before the plugin read the SIF
        if [[ -n ${sif_log} ]]; then
            echo "${sif_log}" >&2
        fi
        echo "WARNING: Flang could not parse ${input_file}, which the selective" >&2
        echo "  instrumentation file lists exclude; SALT-FM copies it but does not" >&2
        echo "  write ${mod_files}, so ${can_fail}" >&2
    else
        if [[ -n ${sif_log} ]]; then
            echo "${sif_log}" >&2
        fi
        if [[ -n ${kind} && ${parse_excluded_modules} == off ]]; then
            echo "WARNING: not parsing ${input_file}, which the selective instrumentation" >&2
            echo "  file lists exclude; SALT-FM does not write ${mod_files}, so" >&2
            echo "  ${can_fail}" >&2
        fi
    fi
    # This copy is exact, unlike $(<file), which drops the newlines at the
    # end; the plugin's copy, after a parse, adds a newline at the end when
    # the source has none
    "${_SCRIPT_DIR}/salt-selectfile" --copy "${input_file}" "${output_file}"
    exit 0
fi
# Status 2 is an error in the SIF, which the plugin reports
if [[ ${sif_status} -ne 0 && ${sif_status} -ne 2 ]]; then
    if [[ -n ${sif_log} ]]; then
        echo "${sif_log}" >&2
    fi
    echo "WARNING: salt-selectfile failed with status ${sif_status}, so SALT-FM" >&2
    echo "  parses ${input_file} before it applies the file lists" >&2
fi
run_flang
