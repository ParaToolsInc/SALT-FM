# Lines that must not trigger any warning. In a routine list a '#' comment
# warns unless the next character is the end of the line, whitespace or
# one of the 14 quiet punctuation characters, all listed below after the
# '#=====' ruler. The quoted "#noinst#" entry still excludes
# dosomething_noinst. FILE lists use '*' as their wildcard, so a '#' line
# there is a plain comment with no warning either.
BEGIN_EXCLUDE_LIST
# exclude the noinst routine
#
#=====
#"
#'
#+
#,
#/
#;
#?
#\
#^
#`
#{
#|
#}
"#noinst#"
END_EXCLUDE_LIST
BEGIN_FILE_INCLUDE_LIST
#sif_excl_wildcard_prefix.cpp
END_FILE_INCLUDE_LIST
BEGIN_FILE_EXCLUDE_LIST
#sif_excl_wildcard_prefix.cpp
END_FILE_EXCLUDE_LIST
