# The spaces and tabs at the ends of the lines below are deliberate
# (see .gitattributes and .editorconfig). Each line is trimmed, so the
# exclude list removes excluded_routine and the file include list keeps
# the test source.
BEGIN_EXCLUDE_LIST 	
"#excluded_routine#"	 
END_EXCLUDE_LIST 
BEGIN_FILE_INCLUDE_LIST	
sif_excl.* 
END_FILE_INCLUDE_LIST 
