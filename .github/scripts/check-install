#!/usr/bin/env bash
#
# check-install -- Install SALT-FM and check the installed saltfm.
#
# The tests run the tools in the build tree, so this checks that an
# installed saltfm finds its libraries, plugin, and default configuration
# file: it instruments a C and a Fortran source without --config_file,
# and a Fortran source with --tau_build_uses_salt_flang, which on Flang 23
# on Linux needs the installed unchanged compiler modules, and each output
# must have a timer. Run it from the source directory.
#
# Usage: .github/scripts/check-install <build dir> <install prefix>

set -euo pipefail
# Check the default configuration file, not one the environment names
unset SALT_CONFIG_FILE

build="$1"
prefix="$2"
cmake --install "${build}" --prefix "${prefix}" > /dev/null
salt="${prefix}/bin/saltfm"
"${salt}" tests/hello.c --tau_output="${prefix}/hello.inst.c"
grep -q TAU_PROFILE_START "${prefix}/hello.inst.c"
"${salt}" tests/fortran/hello.f90 --tau_output="${prefix}/hello.inst.F90"
grep -q TAU_PROFILE_START "${prefix}/hello.inst.F90"
"${salt}" --tau_build_uses_salt_flang tests/fortran/use-intrinsic-c-binding.f90 \
    --tau_output="${prefix}/use-intrinsic-c-binding.inst.F90"
grep -q TAU_PROFILE_START "${prefix}/use-intrinsic-c-binding.inst.F90"
